# Salin ke .env lalu sesuaikan
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
ADMIN_EMAIL=admin@dataklin.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Dataklin

# Threshold default alert skor kualitas (0-100)
DEFAULT_ALERT_THRESHOLD=75

CORS_ORIGINS=http://localhost:3005

# S3 / MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dataklin-raw

# LLM gateway (OpenAI-compatible) — kosongkan untuk menonaktifkan fitur AI.
# Isi dengan endpoint gateway pilihanmu, contoh:
#   LLM_BASE_URL=https://gateway-anda.example.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=nama-model
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# SMTP untuk notifikasi email (F10/F12). Di docker-compose dev, SMTP_HOST sudah diarahkan
# ke Mailhog (lihat web UI-nya di http://localhost:8025) — override di sini untuk produksi.
# Channel Webhook/Slack/daftar email penerima diatur per-organisasi lewat UI (Monitoring →
# Pengaturan Notifikasi), bukan di sini.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_FROM=dataklin@perusahaan-anda.com
# SMTP_USE_TLS=true

# Enkripsi kredensial Koneksi Database (backlog #2). Di docker-compose dev sudah diisi
# kunci contoh (lihat docker-compose.yml) — WAJIB generate kunci baru untuk produksi:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
